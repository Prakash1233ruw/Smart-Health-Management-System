{
  "info": {
    "name": "Smart Health — AI Symptom Analyzer",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "See AI-SYMPTOM-ANALYZER.md for setup. Some cases require separate identities/server configuration. Use demo data; never share populated credential variables."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "username",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "otherPatientId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "missingPatientId",
      "value": "999999999",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.unset(\"token\");",
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"token\", pm.response.text().replace(/^JWT Token:\\s*/, \"\").trim()); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Analyze own patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/ai/symptom-analysis",
        "body": {
          "mode": "raw",
          "raw": "{\"patientId\":{{patientId}},\"symptoms\":[\"fever\",\"cough\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Structured decision support\", () => { const data = pm.response.json(); pm.expect([\"LOW\", \"MODERATE\", \"HIGH\", \"EMERGENCY\"]).to.include(data.riskLevel); pm.expect(data.possibleConditions).to.be.an(\"array\"); pm.expect(data.disclaimer).to.include(\"not a diagnosis\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Empty symptoms",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/ai/symptom-analysis",
        "body": {
          "mode": "raw",
          "raw": "{\"patientId\":{{patientId}},\"symptoms\":[]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid patient ID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/ai/symptom-analysis",
        "body": {
          "mode": "raw",
          "raw": "{\"patientId\":0,\"symptoms\":[\"cough\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "No authentication",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/ai/symptom-analysis",
        "body": {
          "mode": "raw",
          "raw": "{\"patientId\":{{patientId}},\"symptoms\":[\"fever\",\"cough\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/ai/symptom-analysis",
        "body": {
          "mode": "raw",
          "raw": "{\"patientId\":{{patientId}},\"symptoms\":[\"fever\",\"cough\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "invalid.token",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Patient: other patient's data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/ai/symptom-analysis",
        "body": {
          "mode": "raw",
          "raw": "{\"patientId\":{{otherPatientId}},\"symptoms\":[\"cough\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Doctor: missing patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/ai/symptom-analysis",
        "body": {
          "mode": "raw",
          "raw": "{\"patientId\":{{missingPatientId}},\"symptoms\":[\"cough\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "AI unavailable (key unset)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/ai/symptom-analysis",
        "body": {
          "mode": "raw",
          "raw": "{\"patientId\":{{patientId}},\"symptoms\":[\"fever\",\"cough\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 503\", () => pm.response.to.have.status(503));"
            ]
          }
        }
      ]
    }
  ]
}
